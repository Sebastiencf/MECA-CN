<%- include ("header") %>

<main>


    <div class="admin-actions">
            <a href="/admin/offres" class="ajoutarticle-link"> ← Retourner en arrière</a>
    </div>   




    <p>
        Bienvenue <strong><%= username %></strong>.<br>
        Vous souhaitez ajouter une offre d'emploi ?
    </p>

    <form action="/ajouteroffre" method="POST" class="ajout-form">

        <div class="row-two">
            <div class="intitule">
                <label>Intitulé de l'offre</label>
                <input class="intitule-input" id="intitule" name="intitule" type="text" placeholder="Assistant administratif..." />
            </div>
            <div class="type">
                <label>Type d'offre</label>
                <input type="text" value="CDI" id="type", name="type-offre">
            </div>
        </div>

        <div class="row-two">


            <div class="localisation">
                <label>Localisation</label>
                <input type="text" value="Widehem" id="localisation" name="localisation"/>
            </div>


            <div class="salaire">
                <label>Salaire proposé</label>
                <input type="text" placeholder="41 000 €/an" name="salaire" id="salaire"/>

                <label class="switch">
                    <label class="smaller-label">Afficher</label>
                    <input name="salaire-switch" type="checkbox" checked>
                    <span class="slider round"></span>
                </label>
            </div>


        </div>

        <div class="form-separator"></div>

        <div class="presentation">
            <label>Présentation de l'entreprise</label>
            <textarea type="text" value="<%= presentation %>" name="presentation" id="presentation"> </textarea>
        </div>

        <div class="missions">
            <label>Missions proposées</label>
            <textarea type="text" placeholder="Au sein de l'entreprise, vous devrez..." name="missions" id="missions"> </textarea>
        </div>




        <div class="methode">
            <label>Méthode de travail</label>
            <textarea type="text" placeholder="Télétravail" name="methode" id="methode"> </textarea>

            <label class="switch">
                <label class="smaller-label">Afficher</label>
                <input name="methode-switch" type="checkbox" checked>
                <span class="slider round"></span>
            </label>
        </div>




        <div class="competences">
            <label>Compétences recherchées</label>
            <textarea type="text" placeholder="Nous recherchons quelqu'un qui..." name="competences" id="competences"> </textarea>
        </div>




        <div class="avantage">
            <label>Avantages proposés</label>
            <textarea type="text" placeholder="À nos côtés, vous bénéficierez de..." name="avantage" id="avantage"> </textarea>

            <label class="switch">
                <label class="smaller-label">Afficher</label>
                <input name="avantage-switch" type="checkbox" checked>
                <span class="slider round"></span>
            </label>
        </div>




        <div class="recrutement">
            <label>Processus de recrutement</label>
            <textarea type="text" placeholder="Si vous êtes sélectionnés..." name="recrutement" id="recrutement"> </textarea>

            <label class="switch">
                <label class="smaller-label">Afficher</label>
                <input name="recrutement-switch" type="checkbox" checked>
                <span class="slider round"></span>
            </label>
        </div>




        <div class="form-separator"></div>

        <div class="row-two">
            <div class="categorie">
                <label>Catégorie</label>
                <select name="categorie" id="categorie">
                    <% for (const element of categories){ %>
                        <option value="<%= element %>"><%= element %></option>
                    <% } %>
                    <option value="autre">Autre</option>
                </select>
            </div>
            <div class="autre-categorie" id="autre-categorie" style="display: none;">
                <label>Nouvelle catégorie</label>
                <input type="text" name="nouvelleCategorie" id="nouvelleCategorie" placeholder="Ex : Marketing"/>
            </div>
        </div>




        <div class="complementaire">
            <label>Informations complémentaires</label>
            <textarea type="text" placeholder="Informations supplémentaires..." name="complementaire" id="complementaire"> </textarea>

            <label class="switch">
                <label class="smaller-label">Afficher</label>
                <input name="infos-switch" type="checkbox" checked>
                <span class="slider round"></span>
            </label>
        </div>




        <div class="validate-holder">
            <button type="submit" class="validate-btn">Valider l'offre</button>
            <p>Pensez à bien vérifier les informations avant de valider</p>
        </div>

    </form>
</main>

<script>
    const categorieSelect = document.getElementById("categorie");
    const autreCategorie = document.getElementById("autre-categorie");

    // Fonction pour gérer l'affichage/masquage
    function toggleAutreCategorie() {
        autreCategorie.style.display = categorieSelect.value === "autre" ? "block" : "none";
    }

    // Exécuter au chargement de la page
    toggleAutreCategorie();

    // Exécuter au changement
    categorieSelect.addEventListener("change", toggleAutreCategorie);
</script>

<%- include("footer") %>